# -----------------------------------------------------------------------------
# Nacif Electric - Configurações de Ambiente do Backend (Fastify API)
# -----------------------------------------------------------------------------

# Ambiente de execução (development | test | production)
NODE_ENV=development

# Porta do servidor HTTP
PORT=3001

# URL base do Frontend (para liberação de CORS e redirecionamentos pós-checkout)
# Em desenvolvimento: http://localhost:5173
# Em produção: https://nacifenergy.com.br
FRONTEND_URL=https://nacifenergy.com.br

# Conexão com o Banco de Dados (MySQL / MariaDB via Prisma ORM)
DATABASE_URL="mysql://root:root@127.0.0.1:3306/nacif_electric"

# Chave secreta de alta entropia para assinatura de tokens JWT
JWT_SECRET="troque-por-um-segredo-forte-de-pelo-menos-32-caracteres"

# Diretório para armazenamento local de uploads
UPLOAD_DIR="./uploads"

# Integração opcional com OpenAI para análise assistida de plantas e diagramas
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.5"

# -----------------------------------------------------------------------------
# Stripe Billing & Assinaturas
# -----------------------------------------------------------------------------
# Chave Secreta da API (Dashboard Stripe -> Desenvolvedores -> Chaves de API)
STRIPE_SECRET_KEY="sk_test_..."

# Chave Secreta de Assinatura do Webhook (Dashboard Stripe -> Webhooks ou 'stripe listen')
STRIPE_WEBHOOK_SECRET="whsec_..."

# Chave Publicável da Stripe (opcional para o backend, obrigatória no frontend)
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# IDs de Preço dos Planos (Stripe Dashboard -> Catálogo de Produtos -> Preços)
# NOTA: Nacif Estudante tem APENAS preço mensal (semestral/anual indisponível por regra)
STRIPE_PRICE_ESTUDANTE_MONTHLY="price_test_estudante_monthly"

STRIPE_PRICE_ELETRICO_MONTHLY="price_test_eletrico_monthly"
STRIPE_PRICE_ELETRICO_ANNUAL="price_test_eletrico_annual"

STRIPE_PRICE_SOLAR_MONTHLY="price_test_solar_monthly"
STRIPE_PRICE_SOLAR_ANNUAL="price_test_solar_annual"

STRIPE_PRICE_COMPLETO_MONTHLY="price_test_completo_monthly"
STRIPE_PRICE_COMPLETO_ANNUAL="price_test_completo_annual"

