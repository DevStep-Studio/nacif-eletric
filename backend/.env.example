# -----------------------------------------------------------------------------
# Nacif Electric - Configurações de Ambiente do Backend (Fastify API)
# -----------------------------------------------------------------------------

# Ambiente de execução (development | test | production)
NODE_ENV=production

# Porta do servidor HTTP
PORT=3001

# URL base do Frontend (para liberação de CORS e redirecionamentos pós-checkout)
# Em desenvolvimento: http://localhost:5173
# Em produção: https://nacifenergy.com.br
FRONTEND_URL=https://nacifenergy.com.br

# Conexão com o Banco de Dados (MySQL / MariaDB via Prisma ORM)
DATABASE_URL="mysql://root:root@127.0.0.1:3306/nacif_electric"

# Chave secreta de alta entropia para assinatura de tokens JWT
JWT_SECRET="troque-por-um-segredo-forte-de-pelo-menos-32-caracteres"

# Diretório para armazenamento local de uploads
UPLOAD_DIR="./uploads"

# Integração opcional com OpenAI para análise assistida de plantas e diagramas
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.5"

# -----------------------------------------------------------------------------
# Stripe Billing & Assinaturas (Configuração de Produção - Live Mode)
# -----------------------------------------------------------------------------
# Chave Secreta da API (Dashboard Stripe em Live Mode -> Desenvolvedores -> Chaves de API)
# OBRIGATÓRIO PARA LIVE MODE: Deve começar com sk_live_...
STRIPE_SECRET_KEY="sk_live_..."

# Chave Secreta de Assinatura do Webhook (Dashboard Stripe -> Desenvolvedores -> Webhooks -> Endpoint de Produção)
# OBRIGATÓRIO PARA SEGURANÇA: Deve começar com whsec_... para validação criptográfica HMAC SHA256.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Chave Publicável da Stripe (opcional no backend, usada para auditoria e status)
STRIPE_PUBLISHABLE_KEY="pk_live_..."

# IDs de Preço dos Planos (Stripe Dashboard em Live Mode -> Catálogo de Produtos -> Preços)
# NOTA DE REGRA DE NEGÓCIO: Nacif Estudante tem APENAS preço mensal (R$ 99,99/mês). Semestral/anual indisponível.
STRIPE_PRICE_ESTUDANTE_MONTHLY="price_..." # R$ 99,99 / mês

STRIPE_PRICE_ELETRICO_MONTHLY="price_..."   # R$ 149,90 / mês
STRIPE_PRICE_ELETRICO_ANNUAL="price_..."    # R$ 1.259,16 / ano (-30% OFF)

STRIPE_PRICE_SOLAR_MONTHLY="price_..."       # R$ 149,90 / mês
STRIPE_PRICE_SOLAR_ANNUAL="price_..."        # R$ 1.259,16 / ano (-30% OFF)

STRIPE_PRICE_COMPLETO_MONTHLY="price_..."    # R$ 210,00 / mês
STRIPE_PRICE_COMPLETO_ANNUAL="price_..."     # R$ 1.764,00 / ano (-30% OFF)
