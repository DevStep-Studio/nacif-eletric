# ==============================================================================
# NACIF ELECTRIC — MODELO DE VARIÁVEIS DE AMBIENTE (ENV TEMPLATE)
# ==============================================================================
# ATENÇÃO: NUNCA versione valores reais de chaves privadas ou senhas de produção!
# Copie este arquivo para .env.local (desenvolvimento) ou configure no painel do host.

# 1. IDENTIFICAÇÃO DE AMBIENTE E VERSÃO
# Valores permitidos: development | staging | production
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0
VITE_APP_URL=https://nacifenergy.com.br

# 2. ENDPOINT DE API DO BACKEND
# Deixe em branco para consumir /api pela mesma origem (proxy Vite/Nginx).
# Para backend separado, informe a origem da API sem o sufixo /api:
# Exemplo: https://api.nacifenergy.com.br
VITE_API_BASE_URL=

# 3. INTEGRAÇÕES EXTERNAS (GOOGLE APIS)
# Chaves de API para Geocodificação, Mapas e Projeto Solar Fotovoltaico
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_SOLAR_API_KEY=

# 4. TELEMETRIA E MONITORAMENTO DE INFRAESTRUTURA
VITE_ENABLE_HEALTH_PROBES=true
VITE_SENTRY_DSN=

# 5. STRIPE BILLING (FRONTEND)
# Chave Publicável da Stripe (Dashboard Stripe -> Desenvolvedores -> Chaves de API)
# Em produção (Live Mode), utilize obrigatoriamente a chave pública que inicia com pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Preços e links de contratação são resolvidos exclusivamente pelo backend.

# 6. CONFIGURAÇÃO SMTP (BACKEND / NODEMAILER - REDEFINIÇÃO DE SENHA)
SMTP_HOST=smtp.seudominio.com.br
SMTP_PORT=587
SMTP_USER=nao-responda@nacifenergy.com.br
SMTP_PASS=sua-senha-smtp-ou-app-password
SMTP_SECURE=false
SMTP_FROM="Nacif Energy <nao-responda@nacifenergy.com.br>"
