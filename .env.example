# ==============================================================================
# NACIF ELECTRIC — MODELO DE VARIÁVEIS DE AMBIENTE (ENV TEMPLATE)
# ==============================================================================
# ATENÇÃO: NUNCA versione valores reais de chaves privadas ou senhas de produção!
# Copie este arquivo para .env.local (desenvolvimento) ou configure no painel do host.

# 1. IDENTIFICAÇÃO DE AMBIENTE E VERSÃO
# Valores permitidos: development | staging | production
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0
VITE_APP_URL=https://nacifenergy.com.br

# 2. ENDPOINT DE API DO BACKEND
# Deixe em branco para usar o cliente local persistido (IndexedDB / LocalStorage)
# Para ambiente com backend distribuído, aponte a URL base:
# Exemplo: https://api.nacifenergy.com.br
VITE_API_BASE_URL=

# 3. INTEGRAÇÕES EXTERNAS (GOOGLE APIS)
# Chaves de API para Geocodificação, Mapas e Projeto Solar Fotovoltaico
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_SOLAR_API_KEY=

# 4. TELEMETRIA E MONITORAMENTO DE INFRAESTRUTURA
VITE_ENABLE_HEALTH_PROBES=true
VITE_SENTRY_DSN=

# 5. STRIPE BILLING (FRONTEND)
# Chave Publicável da Stripe (Dashboard Stripe -> Desenvolvedores -> Chaves de API)
# Em produção (Live Mode), utilize obrigatoriamente a chave pública que inicia com pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# IDs dos Preços Oficiais da Stripe (Dashboard Stripe em Live Mode -> Catálogo de Produtos -> Preços)
# NOTA: Nacif Estudante possui APENAS faturamento mensal (R$ 99,99/mês)
VITE_STRIPE_PRICE_ESTUDANTE_MONTHLY=price_... # R$ 99,99 / mês
VITE_STRIPE_PRICE_ELETRICO_MONTHLY=price_...   # R$ 149,90 / mês
VITE_STRIPE_PRICE_ELETRICO_ANNUAL=price_...    # R$ 1.259,16 / ano (-30% OFF)
VITE_STRIPE_PRICE_SOLAR_MONTHLY=price_...       # R$ 149,90 / mês
VITE_STRIPE_PRICE_SOLAR_ANNUAL=price_...        # R$ 1.259,16 / ano (-30% OFF)
VITE_STRIPE_PRICE_COMPLETO_MONTHLY=price_...    # R$ 210,00 / mês
VITE_STRIPE_PRICE_COMPLETO_ANNUAL=price_...     # R$ 1.764,00 / ano (-30% OFF)

# 6. STRIPE PAYMENT LINKS & CUSTOMER PORTAL (Fallback de alta disponibilidade em Live Mode)
VITE_STRIPE_LINK_ESTUDANTE_MONTHLY=https://buy.stripe.com/...
VITE_STRIPE_LINK_ELETRICO_MONTHLY=https://buy.stripe.com/...
VITE_STRIPE_LINK_ELETRICO_ANNUAL=https://buy.stripe.com/...
VITE_STRIPE_LINK_SOLAR_MONTHLY=https://buy.stripe.com/...
VITE_STRIPE_LINK_SOLAR_ANNUAL=https://buy.stripe.com/...
VITE_STRIPE_LINK_COMPLETO_MONTHLY=https://buy.stripe.com/...
VITE_STRIPE_LINK_COMPLETO_ANNUAL=https://buy.stripe.com/...
VITE_STRIPE_PORTAL_LOGIN_URL=https://billing.stripe.com/p/login/...
