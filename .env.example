# ==============================================================================
# NACIF ELECTRIC — MODELO DE VARIÁVEIS DE AMBIENTE (ENV TEMPLATE)
# ==============================================================================
# ATENÇÃO: NUNCA versione valores reais de chaves privadas ou senhas de produção!
# Copie este arquivo para .env.local (desenvolvimento) ou configure no painel do host.

# 1. IDENTIFICAÇÃO DE AMBIENTE E VERSÃO
# Valores permitidos: development | staging | production
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0
VITE_APP_URL=https://nacifenergy.com.br

# 2. ENDPOINT DE API DO BACKEND
# Deixe em branco para usar o cliente local persistido (IndexedDB / LocalStorage)
# Para ambiente com backend distribuído, aponte a URL base:
# Exemplo: https://api.nacifenergy.com.br
VITE_API_BASE_URL=

# 3. INTEGRAÇÕES EXTERNAS (GOOGLE APIS)
# Chaves de API para Geocodificação, Mapas e Projeto Solar Fotovoltaico
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_SOLAR_API_KEY=

# 4. TELEMETRIA E MONITORAMENTO DE INFRAESTRUTURA
VITE_ENABLE_HEALTH_PROBES=true
VITE_SENTRY_DSN=
