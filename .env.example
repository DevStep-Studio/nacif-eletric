# ==============================================================================
# NACIF ELECTRIC — MODELO DE VARIÁVEIS DE AMBIENTE (ENV TEMPLATE)
# ==============================================================================
# ATENÇÃO: NUNCA versione valores reais de chaves privadas ou senhas de produção!
# Copie este arquivo para .env.local (desenvolvimento) ou configure no painel do host.

# 1. IDENTIFICAÇÃO DE AMBIENTE E VERSÃO
# Valores permitidos: development | staging | production
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0
VITE_APP_URL=https://nacifenergy.com.br

# 2. ENDPOINT DE API DO BACKEND
# Deixe em branco para usar o cliente local persistido (IndexedDB / LocalStorage)
# Para ambiente com backend distribuído, aponte a URL base:
# Exemplo: https://api.nacifenergy.com.br
VITE_API_BASE_URL=

# 3. INTEGRAÇÕES EXTERNAS (GOOGLE APIS)
# Chaves de API para Geocodificação, Mapas e Projeto Solar Fotovoltaico
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_SOLAR_API_KEY=

# 4. TELEMETRIA E MONITORAMENTO DE INFRAESTRUTURA
VITE_ENABLE_HEALTH_PROBES=true
VITE_SENTRY_DSN=

# 5. STRIPE BILLING (FRONTEND)
# Chave Publicável da Stripe (Dashboard Stripe -> Desenvolvedores -> Chaves de API)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# IDs dos Preços (Dashboard Stripe -> Catálogo de Produtos -> Preços)
# NOTA: Nacif Estudante tem APENAS faturamento mensal
VITE_STRIPE_PRICE_ESTUDANTE_MONTHLY=price_1UVAQqJl6h9d8TBMRYFoOdBM
VITE_STRIPE_PRICE_ELETRICO_MONTHLY=price_1UVAS5Jl6h9d8TBMQLt9F7nB
VITE_STRIPE_PRICE_ELETRICO_ANNUAL=price_1UVAfiJl6h9d8TBMcF6J01KS
VITE_STRIPE_PRICE_SOLAR_MONTHLY=price_1UVAX2Jl6h9d8TBMkWZsDn0s
VITE_STRIPE_PRICE_SOLAR_ANNUAL=price_1UVAgGJl6h9d8TBMmK3sEsRZ
VITE_STRIPE_PRICE_COMPLETO_MONTHLY=price_1UVAYaJl6h9d8TBMc8YTZsHp
VITE_STRIPE_PRICE_COMPLETO_ANNUAL=price_1UVAgoJl6h9d8TBMubc39FAP

# 6. STRIPE PAYMENT LINKS & CUSTOMER PORTAL (Fallback de alta disponibilidade)
VITE_STRIPE_LINK_ESTUDANTE_MONTHLY=https://buy.stripe.com/test_eVq9AU2j39m1dfl6HkbQY01
VITE_STRIPE_LINK_ELETRICO_MONTHLY=https://buy.stripe.com/test_dRmdRa7Dncyd4IPc1EbQY02
VITE_STRIPE_LINK_ELETRICO_ANNUAL=https://buy.stripe.com/test_3cI3cwaPz69P7V19TwbQY03
VITE_STRIPE_LINK_SOLAR_MONTHLY=https://buy.stripe.com/test_3cI9AUe1LdCh0sz9TwbQY04
VITE_STRIPE_LINK_SOLAR_ANNUAL=https://buy.stripe.com/test_6oU14o8Hr9m12AH9TwbQY05
VITE_STRIPE_LINK_COMPLETO_MONTHLY=https://buy.stripe.com/test_dRm00k6zj1Tzfnte9MbQY06
VITE_STRIPE_LINK_COMPLETO_ANNUAL=https://buy.stripe.com/test_28E5kE5vf2XD3ELe9MbQY07
VITE_STRIPE_PORTAL_LOGIN_URL=https://billing.stripe.com/p/login/test_14A00k8Hrbu91wD0iWbQY00


